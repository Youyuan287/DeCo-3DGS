 __all__ = ['Data', 'Batch']
 
 
+class _CallableKeys(list):
+    """List of attribute names that is also callable.
+
+    The vendored SPT revision calls `data.keys()` (method style) while
+    torch_geometric 2.3.0 exposes `Data.keys` as a property returning a list.
+    Returning a callable list keeps both call styles working without touching
+    any call site.
+    """
+
+    def __call__(self):
+        return list(self)
+
+
 class Data(PyGData):
+    @property
+    def keys(self):
+        return _CallableKeys(super().keys)
+
     """Inherit from torch_geometric.Data with extensions tailored to our
     specific needs.
     """
